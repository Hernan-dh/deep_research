# OpenAI Agents SDK
OPENAI_API_KEY=your-openai-api-key
DEFAULT_MODEL_NAME=gpt-5.4-mini
HOW_MANY_SEARCHES=5

# Email delivery
USE_EMAIL=true
EMAIL_ADDRESS=your-sender@gmail.com
EMAIL_SMTP_SERVER=smtp.gmail.com
EMAIL_APP_PASSWORD=your-app-password

# Optional Pushover fallback
PUSHOVER_USER=your-pushover-user
PUSHOVER_TOKEN=your-pushover-token

# Commit metadata generation: Gemini models are tried in order, then Groq
GEMINI_API_KEY=your-gemini-api-key
GEMINI_COMMIT_MODELS=gemini-3.5-flash,gemini-3.7-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite
GROQ_API_KEY=your-groq-api-key
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_COMMIT_MODEL=openai/gpt-oss-120b
COMMIT_GENERATION_TIMEOUT=15
