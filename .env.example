# OpenAI Agents SDK
OPENAI_API_KEY=your-openai-api-key
DEFAULT_MODEL_NAME=gpt-5.4-mini
HOW_MANY_SEARCHES=5

# Commit metadata generation: Gemini models are tried in order, then Groq
GEMINI_API_KEY=your-gemini-api-key
GEMINI_COMMIT_MODELS=gemini-3.5-flash,gemini-3.7-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite
GROQ_API_KEY=your-groq-api-key
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_COMMIT_MODEL=openai/gpt-oss-120b
COMMIT_GENERATION_TIMEOUT=15
